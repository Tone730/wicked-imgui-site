# Copy this file to .env in the dashboard root and fill in only what you have.
# The server loads it automatically; real environment variables override these values.
# NEVER commit .env or share PAYHIP_API_KEY / BILLING_WEBHOOK_SECRET in chat.

# ---- Payhip checkout (free forever plan)
# Create TWO Membership products in Payhip (recurring requires Stripe):
#   Wicked Imgui Pro — Monthly : one plan, $10 every month
#   Wicked Imgui Pro — Yearly  : one plan, $108 every year
# Payhip has no direct checkout links for memberships, so use the product
# page URLs: https://payhip.com/b/YOUR_PRODUCT_KEY
BILLING_PROVIDER=payhip
PAYHIP_API_KEY=
CHECKOUT_URL_MONTHLY=
CHECKOUT_URL_YEARLY=

# Optional: your Payhip store or product page for "Manage subscription".
CHECKOUT_PORTAL_URL=

# Optional alternative links shown on Billing. Empty stays hidden.
PAYHIP_URL=
GUMROAD_URL=
KOFI_URL=
SPONSORS_URL=
PAYPAL_URL=

# ---- Account server (only needed if hosting the API)
NODE_ENV=production
BIND_HOST=0.0.0.0
LICENSE_SECRET=
ADMIN_TOKEN=
ALLOWED_ORIGINS=https://YOUR_USERNAME.github.io
COOKIE_SECURE=1
COOKIE_SAMESITE=None
DATA_FILE=/var/data/licenses.json
ACCOUNTS_FILE=/var/data/accounts.json

# ---- Generic webhook mode (only when BILLING_PROVIDER is not payhip)
# BILLING_WEBHOOK_SECRET=
