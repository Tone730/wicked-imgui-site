# Copy this file to .env in the dashboard root and fill in only what you have.
# The server loads it automatically; real environment variables override these values.
# NEVER commit .env or share PAYHIP_API_KEY / BILLING_WEBHOOK_SECRET in chat.

# ---- Payhip checkout (free forever plan)
# Create ONE Membership product in Payhip (recurring requires Stripe) with two
# plans: $25 every month and $108 every year. In each plan's row use "Copy URL"
# for a direct checkout URL: https://payhip.com/order?link=KEY&pricing_plan=PLAN_ID
# The general product page is https://payhip.com/b/KEY (used for Manage).
BILLING_PROVIDER=payhip
PAYHIP_API_KEY=
CHECKOUT_URL_MONTHLY=
CHECKOUT_URL_YEARLY=

# Optional: your Payhip store or product page for "Manage subscription".
CHECKOUT_PORTAL_URL=

# Optional alternative links shown on Billing. Empty stays hidden.
PAYHIP_URL=
GUMROAD_URL=
KOFI_URL=
SPONSORS_URL=
PAYPAL_URL=

# ---- Email delivery (password resets + email confirmation)
# Pick ONE provider. Checked in order: Brevo, Resend, webhook.

# Option A (RECOMMENDED, no domain needed): Brevo free tier, 300 emails/day.
# Sign up at https://www.brevo.com, verify your own email as a sender in
# "Senders & IPs", create an API key, then set BREVO_API_KEY and MAIL_FROM
# to that verified address. Sends to ANY recipient with no domain required.
BREVO_API_KEY=
MAIL_FROM=Wicked Imgui <wick777@engineer.com>

# Option B: Resend. Needs a verified sending domain to reach non-owner addresses;
# without one it only delivers to the account owner's own email.
# RESEND_API_KEY=
# MAIL_FROM=Wicked Imgui <no-reply@yourdomain.com>
MAIL_REPLY_TO=wick777@engineer.com
# Public dashboard URL used to build the links inside those emails.
SITE_URL=https://tone730.github.io/wicked-imgui-site/
# Alternative: route {to,type,token,link,subject,text,html} to your own automation.
# If all providers are empty, no mail is sent and verification is skipped.
MAIL_WEBHOOK_URL=
# Local debugging only: print the confirmation link to the server console.
DEV_MAIL_TOKENS=

# ---- Managed persistence (recommended for hosted accounts)
# Run server/supabase.sql once in your Supabase project, then set these three.
# Leave STORAGE_BACKEND empty to use local JSON files (fine for development only).
STORAGE_BACKEND=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Account server (only needed if hosting the API)
NODE_ENV=production
BIND_HOST=0.0.0.0
LICENSE_SECRET=
# Bearer fallback for admin.html. Entered at runtime in that page and kept only
# in browser sessionStorage — never put this value in site code or this repo.
ADMIN_TOKEN=
ALLOWED_ORIGINS=https://YOUR_USERNAME.github.io
COOKIE_SECURE=1
COOKIE_SAMESITE=None
DATA_FILE=/var/data/licenses.json
ACCOUNTS_FILE=/var/data/accounts.json

# ---- Admin access, credits and legal versions
# ADMIN_EMAILS grants the admin role to those account emails (comma-separated).
# If BOTH ADMIN_EMAILS and ADMIN_TOKEN are empty, every /admin/api/* route is denied.
ADMIN_EMAILS=
AUDIT_FILE=/var/data/audit.jsonl

# One access credit buys this many Pro days. Keys minted from credits or issued
# by an admin are capped at MAX_KEY_DEVICES device seats.
ACCESS_CREDIT_DAYS=30
MAX_KEY_DEVICES=5

# Sent by signup and stored with the acceptance timestamp on each account.
# Bump these together with js/config.js legal versions whenever the text changes.
TERMS_VERSION=2026-11-19
PRIVACY_VERSION=2026-11-19

# The local full-access Maker build stays offline and uses the user's own provider
# keys; it does not spend Wicked-hosted AI credits. Only server-mediated AI actions
# call POST /v1/ai/usage.

# ---- Update feed signing (release tooling only; see tools/UPDATE_SIGNING.md)
# Private key path. Never commit the key or put it in this file.
# WICKED_RELEASE_KEY_FILE=C:\Users\Wick\.config\wicked-imgui\release-signing.key
# WICKED_RELEASE_SIGNING_KEY=   # PEM text instead of a path, for CI
# Public key x (base64url) pinned in the app; keep in sync with app/main.cjs.
# WICKED_RELEASE_PUBLIC_KEY=qW7bkoHH7TgJRpnmKQRt3ViWwL5DVzWxR4ajJ6S6fn8

# ---- Generic webhook mode (only when BILLING_PROVIDER is not payhip)
# BILLING_WEBHOOK_SECRET=
